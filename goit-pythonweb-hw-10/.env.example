POSTGRES_DB=contacts_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password

DATABASE_URL=postgresql+asyncpg://postgres:replace-with-postgres-password@localhost:5432/contacts_db
APP_NAME=Contacts API Auth
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

MAIL_USERNAME=example@example.com
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=example@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=Contacts API
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
USE_CREDENTIALS=True
VALIDATE_CERTS=True

CLD_NAME=replace-with-cloudinary-cloud-name
CLD_API_KEY=replace-with-cloudinary-api-key
CLD_API_SECRET=replace-with-cloudinary-api-secret

CORS_ORIGINS=*
